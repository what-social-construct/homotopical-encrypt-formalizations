module

public import Mathlib.Basic.Real.Basic
public import Mathlib.Data.Matrix.Mul
public import Mathlib.Tactic

@[expose] public section

/-
  Discrete Euclidean Closest Vector Problem (CVP) vocabulary.

  Paper correspondence:
  - Paper 1 Section 3: the external known-lattice CVP comparison.
  - Paper 1 appendix ledger: CVP instance, solution, oracle, and hardness
    assumption surfaces.

  A lattice basis consists of real ambient vectors with integer coefficients.
  This deliberately differs from the field-linear image `B R^n`: the latter is
  a vector subspace and belongs to the linear algebra in `Hardness.lean`, not to
  this module's CVP interface.

  CVP hardness remains an external complexity assumption. Lean defines the
  discrete problem and its correctness contracts; it does not prove that no
  efficient CVP solver exists.
-/

set_option linter.mathlibStandardSet false
set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

namespace CVP

/-- A vector in the real ambient space indexed by `m`. -/
abbrev AmbientVector (m : Type*) := m → ℝ

/--
An explicit rank-`n` lattice in `ℝ^m`.

The columns of `basis` are linearly independent over `ℝ`. Lattice points use
integer coefficient vectors; real coefficient vectors are used only to state
the full-column-rank condition.
-/
structure ExplicitLattice (m n : Type*) [Fintype n] where
  basis : Matrix m n ℝ
  basis_injective : Function.Injective (Matrix.mulVec basis)

/-- The ambient vector represented by an integer coefficient vector. -/
def latticeVector
    {m n : Type*} [Fintype n]
    (L : ExplicitLattice m n) (z : n → ℤ) : AmbientVector m :=
  L.basis.mulVec fun j => (z j : ℝ)

/-- Membership in the discrete lattice generated by `L`. -/
def InExplicitLattice
    {m n : Type*} [Fintype n]
    (L : ExplicitLattice m n) (v : AmbientVector m) : Prop :=
  ∃ z : n → ℤ, latticeVector L z = v

/-- Squared Euclidean distance; it has the same minimizers as Euclidean distance. -/
def squaredEuclideanDistance
    {m : Type*} [Fintype m]
    (u v : AmbientVector m) : ℝ :=
  ∑ i, (u i - v i) ^ 2

/-- Squared Euclidean distance is nonnegative. -/
theorem squaredEuclideanDistance_nonneg
    {m : Type*} [Fintype m]
    (u v : AmbientVector m) :
    0 ≤ squaredEuclideanDistance u v := by
  unfold squaredEuclideanDistance
  positivity

/-- A CVP instance is a discrete lattice together with an ambient target. -/
structure Instance (m n : Type*) [Fintype n] where
  lattice : ExplicitLattice m n
  target : AmbientVector m

/-- A genuine CVP answer: a closest discrete lattice point to the target. -/
def IsClosestLatticeVector
    {m n : Type*} [Fintype m] [Fintype n]
    (L : ExplicitLattice m n) (t v : AmbientVector m) : Prop :=
  InExplicitLattice L v ∧
    ∀ w, InExplicitLattice L w →
      squaredEuclideanDistance t v ≤ squaredEuclideanDistance t w

/-- A candidate solution to a CVP instance. -/
def Solution
    {m n : Type*} [Fintype m] [Fintype n]
    (I : Instance m n) (v : AmbientVector m) : Prop :=
  IsClosestLatticeVector I.lattice I.target v

/-- An oracle for explicit known-lattice CVP instances. -/
def Oracle (m n : Type*) [Fintype m] [Fintype n] :=
  ExplicitLattice m n → AmbientVector m → AmbientVector m

/-- Minimal oracle contract: the output is a point of the presented lattice. -/
def LatticeOracleCorrect
    {m n : Type*} [Fintype m] [Fintype n]
    (O : Oracle m n) : Prop :=
  ∀ (L : ExplicitLattice m n) (t : AmbientVector m),
    InExplicitLattice L (O L t)

/-- Full correctness contract for exact CVP. -/
def OracleCorrect
    {m n : Type*} [Fintype m] [Fintype n]
    (O : Oracle m n) : Prop :=
  ∀ (L : ExplicitLattice m n) (t : AmbientVector m),
    IsClosestLatticeVector L t (O L t)

/-- Instance-oriented solver correctness. -/
def SolverCorrect
    {m n : Type*} [Fintype m] [Fintype n]
    (O : Oracle m n) : Prop :=
  ∀ I : Instance m n, Solution I (O I.lattice I.target)

/-- The oracle and instance formulations of exact CVP correctness agree. -/
theorem solverCorrect_iff_oracleCorrect
    {m n : Type*} [Fintype m] [Fintype n]
    (O : Oracle m n) :
    SolverCorrect O ↔ OracleCorrect O := by
  constructor
  · intro h L t
    exact h ⟨L, t⟩
  · intro h I
    exact h I.lattice I.target

/--
External exact-CVP hardness assumption schema.

`Efficient` belongs to the surrounding complexity model. Approximate CVP can
be represented by replacing `OracleCorrect` with an approximation contract.
-/
def HardnessAssumption
    {m n : Type*} [Fintype m] [Fintype n]
    (Efficient : Oracle m n → Prop) : Prop :=
  ¬ ∃ O : Oracle m n, Efficient O ∧ OracleCorrect O

/-- The zero-output oracle always satisfies the minimal membership contract. -/
theorem zero_lattice_oracle_correct
    {m n : Type*} [Fintype m] [Fintype n] :
    LatticeOracleCorrect
      (m := m) (n := n)
      (fun (_L : ExplicitLattice m n) (_t : AmbientVector m) => 0) := by
  intro L _t
  refine ⟨0, ?_⟩
  funext i
  simp [latticeVector, Matrix.mulVec, dotProduct]

end CVP

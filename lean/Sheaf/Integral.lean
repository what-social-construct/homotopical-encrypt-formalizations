module

public import CVP
public import Sheaf.Hodge

@[expose] public section

/-!
# Integral structures on finite cellular sheaves

This module equips the existing real coordinate stalks with full-rank integral
lattices.  The sheaf restriction maps must preserve those lattices, so the
real cellular coboundaries restrict to an integral cochain complex.

The degree-one harmonic lattice is intrinsic:

`C¹_ℤ ∩ ker Δ₁`.

It is not identified with the whole real harmonic subspace.  An explicit
basis presentation, when needed for a concrete CVP instance, is separate data.
-/

set_option autoImplicit false

open scoped BigOperators RealInnerProductSpace

noncomputable section

namespace Hcrypt
namespace Sheaf
namespace CellularSheaf

variable
  {Vertex Edge Face : Type*}
  [Fintype Vertex] [Fintype Edge] [Fintype Face]
  {X : OrientedTwoComplex Vertex Edge Face}

/-- A full-rank integral lattice in one real coordinate stalk. -/
structure StalkLattice (n : ℕ) where
  presentation : CVP.ExplicitLattice (Fin n) (Fin n)

namespace StalkLattice

/-- The additive subgroup generated by the integral stalk basis. -/
def carrier {n : ℕ} (L : StalkLattice n) : AddSubgroup (Coord n) where
  carrier := {x | CVP.InExplicitLattice L.presentation x}
  zero_mem' := by
    refine ⟨0, ?_⟩
    funext i
    simp [CVP.latticeVector, Matrix.mulVec, dotProduct]
  add_mem' := by
    rintro x y ⟨a, ha⟩ ⟨b, hb⟩
    refine ⟨a + b, ?_⟩
    funext i
    change
      (∑ j, L.presentation.basis i j * ((a j + b j : ℤ) : ℝ)) =
        x i + y i
    rw [← congrFun ha i, ← congrFun hb i]
    simp only [CVP.latticeVector, Matrix.mulVec, dotProduct,
      Int.cast_add, mul_add, Finset.sum_add_distrib]
  neg_mem' := by
    rintro x ⟨a, ha⟩
    refine ⟨-a, ?_⟩
    funext i
    change (∑ j, L.presentation.basis i j * ((-a j : ℤ) : ℝ)) = -x i
    rw [← congrFun ha i]
    simp [CVP.latticeVector, Matrix.mulVec, dotProduct]

/-- A real stalk vector belongs to the chosen integral lattice. -/
def Contains {n : ℕ} (L : StalkLattice n) (x : Coord n) : Prop :=
  x ∈ L.carrier

/-- A linear stalk map preserves the chosen integral structures. -/
def Preserves
    {m n : ℕ}
    (L : StalkLattice m) (M : StalkLattice n)
    (f : Coord m →ₗ[ℝ] Coord n) : Prop :=
  AddSubgroup.map f.toAddMonoidHom L.carrier ≤ M.carrier

theorem preserves_apply
    {m n : ℕ}
    {L : StalkLattice m} {M : StalkLattice n}
    {f : Coord m →ₗ[ℝ] Coord n}
    (h : L.Preserves M f)
    {x : Coord m} (hx : L.Contains x) :
    M.Contains (f x) := by
  exact h (AddSubgroup.mem_map_of_mem f.toAddMonoidHom hx)

end StalkLattice

/--
Integral structure on an existing real cellular sheaf.

Every stalk carries a full-rank lattice, and all sheaf restriction maps
preserve those lattices.  The real sheaf and its Hodge Laplacian are unchanged.
-/
structure IntegralStructure (F : CellularSheaf X) where
  vertexStalk : ∀ v, StalkLattice (F.vertexDim v)
  edgeStalk : ∀ e, StalkLattice (F.edgeDim e)
  faceStalk : ∀ f, StalkLattice (F.faceDim f)
  restrict01_preserves :
    ∀ v e, (vertexStalk v).Preserves (edgeStalk e) (F.restrict01 v e)
  restrict12_preserves :
    ∀ e f, (edgeStalk e).Preserves (faceStalk f) (F.restrict12 e f)
  restrict02_preserves :
    ∀ v f, (vertexStalk v).Preserves (faceStalk f) (F.restrict02 v f)

namespace IntegralStructure

variable {F : CellularSheaf X}

/-- Integral degree-zero cochains, defined stalkwise. -/
def integralZeroCochains (I : IntegralStructure F) : AddSubgroup F.C0 where
  carrier := {a | ∀ v, component F.vertexDim v a ∈ (I.vertexStalk v).carrier}
  zero_mem' := by
    intro v
    change (0 : Coord (F.vertexDim v)) ∈ (I.vertexStalk v).carrier
    exact (I.vertexStalk v).carrier.zero_mem
  add_mem' := by
    intro a b ha hb v
    simpa using (I.vertexStalk v).carrier.add_mem (ha v) (hb v)
  neg_mem' := by
    intro a ha v
    simpa using (I.vertexStalk v).carrier.neg_mem (ha v)

/-- Integral degree-one cochains, defined stalkwise. -/
def integralOneCochains (I : IntegralStructure F) : AddSubgroup F.C1 where
  carrier := {b | ∀ e, component F.edgeDim e b ∈ (I.edgeStalk e).carrier}
  zero_mem' := by
    intro e
    change (0 : Coord (F.edgeDim e)) ∈ (I.edgeStalk e).carrier
    exact (I.edgeStalk e).carrier.zero_mem
  add_mem' := by
    intro a b ha hb e
    simpa using (I.edgeStalk e).carrier.add_mem (ha e) (hb e)
  neg_mem' := by
    intro a ha e
    simpa using (I.edgeStalk e).carrier.neg_mem (ha e)

/-- Integral degree-two cochains, defined stalkwise. -/
def integralTwoCochains (I : IntegralStructure F) : AddSubgroup F.C2 where
  carrier := {c | ∀ f, component F.faceDim f c ∈ (I.faceStalk f).carrier}
  zero_mem' := by
    intro f
    change (0 : Coord (F.faceDim f)) ∈ (I.faceStalk f).carrier
    exact (I.faceStalk f).carrier.zero_mem
  add_mem' := by
    intro a b ha hb f
    simpa using (I.faceStalk f).carrier.add_mem (ha f) (hb f)
  neg_mem' := by
    intro a ha f
    simpa using (I.faceStalk f).carrier.neg_mem (ha f)

/-- The intrinsic integral harmonic lattice `C¹_ℤ ∩ ker Δ₁`. -/
def harmonicOneLattice (I : IntegralStructure F) : AddSubgroup F.C1 :=
  I.integralOneCochains ⊓ F.harmonicOneSubspace.toAddSubgroup

theorem mem_harmonicOneLattice_iff
    (I : IntegralStructure F) (h : F.C1) :
    h ∈ I.harmonicOneLattice ↔
      h ∈ I.integralOneCochains ∧ h ∈ F.harmonicOneSubspace := by
  rfl

theorem integral_of_mem_harmonicOneLattice
    (I : IntegralStructure F) {h : F.C1}
    (hh : h ∈ I.harmonicOneLattice) :
    h ∈ I.integralOneCochains :=
  hh.1

theorem harmonic_of_mem_harmonicOneLattice
    (I : IntegralStructure F) {h : F.C1}
    (hh : h ∈ I.harmonicOneLattice) :
    h ∈ F.harmonicOneSubspace :=
  hh.2

/-- The cellular coboundary maps integral zero-cochains to integral one-cochains. -/
theorem delta0_mem_integralOneCochains
    (I : IntegralStructure F) {a : F.C0}
    (ha : a ∈ I.integralZeroCochains) :
    F.delta0 a ∈ I.integralOneCochains := by
  intro e
  simp only [delta0, assemble, delta0At, component,
    LinearMap.sum_apply, LinearMap.smul_apply, LinearMap.comp_apply]
  change
    (Finset.univ : Finset Vertex).sum (fun v =>
      X.incidence01Real v e •
        F.restrict01 v e (component F.vertexDim v a)) ∈
      (I.edgeStalk e).carrier
  apply AddSubgroup.sum_mem
  intro v _
  rw [OrientedTwoComplex.incidence01Real, Int.cast_smul_eq_zsmul]
  exact (I.edgeStalk e).carrier.zsmul_mem
    (StalkLattice.preserves_apply (I.restrict01_preserves v e) (ha v))
    (X.incidence01 v e)

/-- The cellular coboundary maps integral one-cochains to integral two-cochains. -/
theorem delta1_mem_integralTwoCochains
    (I : IntegralStructure F) {b : F.C1}
    (hb : b ∈ I.integralOneCochains) :
    F.delta1 b ∈ I.integralTwoCochains := by
  intro f
  simp only [delta1, assemble, delta1At, component,
    LinearMap.sum_apply, LinearMap.smul_apply, LinearMap.comp_apply]
  change
    (Finset.univ : Finset Edge).sum (fun e =>
      X.incidence12Real e f •
        F.restrict12 e f (component F.edgeDim e b)) ∈
      (I.faceStalk f).carrier
  apply AddSubgroup.sum_mem
  intro e _
  rw [OrientedTwoComplex.incidence12Real, Int.cast_smul_eq_zsmul]
  exact (I.faceStalk f).carrier.zsmul_mem
    (StalkLattice.preserves_apply (I.restrict12_preserves e f) (hb e))
    (X.incidence12 e f)

end IntegralStructure

end CellularSheaf
end Sheaf
end Hcrypt
